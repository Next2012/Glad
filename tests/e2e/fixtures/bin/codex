#!/usr/bin/env node

'use strict';

const readline = require('node:readline');

if (process.argv.includes('--version')) {
  process.stdout.write('codex-cli 0.0.0-e2e\n');
  process.exit(0);
}

if (process.argv[2] !== 'app-server') {
  process.stderr.write(`Unsupported fake Codex command: ${process.argv.slice(2).join(' ')}\n`);
  process.exit(1);
}

const input = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
let turnSequence = 0;
let outputLost = false;
const approvalRequests = new Map();
let inputQuestion = null;
let taskPlan = null;
function finishTaskPlan(status = 'completed') {
  if (!taskPlan) return;
  const { turnId, steps, timers } = taskPlan;
  taskPlan = null;
  timers.forEach(clearTimeout);
  if (status === 'completed') write({ method: 'turn/plan/updated', params: {
    threadId: 'thread-e2e', turnId, plan: steps.map(step => ({ step, status: 'completed' }))
  } });
  write({ method: 'item/completed', params: { threadId: 'thread-e2e', turnId,
    item: { id: `plan-answer-${turnId}`, type: 'agentMessage', text: status === 'completed' ? 'Implementation and verification complete.' : 'Work stopped.' }
  } });
  write({ method: 'turn/completed', params: { threadId: 'thread-e2e', turn: { id: turnId, status } } });
}
function finishInputQuestion(text, status = 'completed') {
  const question = inputQuestion;
  if (!question) return;
  inputQuestion = null;
  clearInterval(question.timer);
  if (text) write({ method: 'item/completed', params: {
    threadId: 'thread-e2e', turnId: question.turnId,
    item: { id: `answer-${question.turnId}`, type: 'agentMessage', text }
  } });
  write({ method: 'turn/completed', params: { threadId: 'thread-e2e', turn: { id: question.turnId, status } } });
}
const threadNames = new Map();
const hiddenThreads = new Set();
let titleSequence = 0;
function savedThreadName(id) {
  if (threadNames.has(id)) return threadNames.get(id);
  const match = /^picker-thread-(\d+)$/.exec(id || '');
  return match ? `History ${String(match[1]).padStart(3, '0')}` : null;
}

function largeHistoryTurns() {
  const turns = [];
  let itemSequence = 0;
  for (let turnIndex = 1; turnIndex <= 73; turnIndex += 1) {
    const count = turnIndex <= 20 ? 19 : 18;
    const items = [];
    for (let itemIndex = 0; itemIndex < count; itemIndex += 1) {
      itemSequence += 1;
      items.push({
        id: `history-item-${itemSequence}`,
        type: 'commandExecution',
        command: `history-command-${itemSequence}`,
        status: 'completed',
        aggregatedOutput: `history output ${itemSequence}`
      });
    }
    turns.push({
      id: `history-turn-${turnIndex}`,
      status: 'completed',
      createdAt: 1700000000 + turnIndex,
      completedAt: 1700000000 + turnIndex + 1,
      items
    });
  }
  return turns.reverse();
}

function historicalPlanThread(threadId) {
  const fs = require('node:fs');
  const path = require('node:path');
  const rollout = path.join(process.env.CODEX_HOME, `${threadId}.jsonl`);
  const records = [{ type: 'session_meta', payload: { id: threadId } }];
  const turns = ['completed', 'interrupted'].map((status, index) => {
    const turnId = `saved-plan-turn-${index + 1}`;
    const steps = ['读取历史任务', '恢复步骤状态', '显示任务卡片'];
    const params = { plan: steps.map((step, stepIndex) => ({ step,
      status: index === 0 || stepIndex === 0 ? 'completed' : stepIndex === 1 ? 'in_progress' : 'pending'
    })) };
    records.push({ type: 'event_msg', payload: { type: 'task_started', turn_id: turnId } });
    const callId = `saved-plan-call-${index}`;
    records.push({ type: 'response_item', payload: index === 0
      ? { type: 'function_call', name: 'update_plan', call_id: callId, arguments: JSON.stringify(params) }
      : { type: 'custom_tool_call', name: 'exec', call_id: callId, input: `text(await tools.update_plan(${JSON.stringify(params)}));` }
    });
    records.push({ type: 'response_item', payload: { type: index === 0 ? 'function_call_output' : 'custom_tool_call_output',
      call_id: callId, output: index === 0 ? 'Plan updated' : [{ type: 'input_text', text: 'Script completed\nOutput:\n{}' }]
    } });
    records.push({ type: 'event_msg', payload: { type: index === 0 ? 'task_complete' : 'turn_aborted', turn_id: turnId } });
    return { id: turnId, status, createdAt: 1700000000 + index * 60, completedAt: 1700000010 + index * 60, items: [
      { type: 'userMessage', id: `${turnId}-user`, content: [{ type: 'text', text: `历史命令 ${index + 1}` }] },
      { type: 'agentMessage', id: `${turnId}-reply`, text: `历史回复 ${index + 1}` }
    ] };
  });
  fs.writeFileSync(rollout, records.map(record => JSON.stringify(record)).join('\n') + '\n');
  return { thread: { id: threadId, path: rollout, turns: [] }, initialTurnsPage: { data: turns.reverse(), nextCursor: null } };
}

function write(message) {
  if (outputLost) return;
  process.stdout.write(`${JSON.stringify(message)}\n`);
}

input.on('line', line => {
  let request;
  try {
    request = JSON.parse(line);
  } catch (_) {
    return;
  }
  if (request.id == null) return;
  if (['thread/start', 'thread/resume', 'thread/fork'].includes(request.method)
    && !request.params?.ephemeral && request.params?.config?.['tools.update_plan.enabled'] !== true) {
    write({ id: request.id, error: { message: 'Glad conversation threads must enable the planning tool' } });
    return;
  }
  if (!request.method) {
    if (inputQuestion?.rpcID === request.id) {
      const answers = request.result?.answers || {};
      if (!answers.count?.answers?.[0] || !answers.people?.answers?.[0]) {
        finishInputQuestion('ERROR: question was answered automatically', 'failed');
      } else {
        finishInputQuestion(`Received answer: ${answers.count.answers[0]}; ${answers.people.answers[0]}`);
      }
      return;
    }
    const approval = approvalRequests.get(String(request.id));
    if (approval) {
      approvalRequests.delete(String(request.id));
      write({
        method: 'item/completed',
        params: {
          threadId: approval.threadId, turnId: approval.turnId,
          item: {
            id: approval.itemId, type: 'commandExecution', command: 'approval-command',
            status: 'completed', aggregatedOutput: 'approved', exitCode: 0
          }
        }
      });
      write({
        method: 'turn/completed',
        params: { threadId: approval.threadId, turn: { id: approval.turnId, status: 'completed' } }
      });
    }
    return;
  }

  let result = {};
  if (request.method === 'thread/read') {
    result = { thread: { id: request.params.threadId, name: savedThreadName(request.params.threadId), turns: [] } };
  } else if (request.method === 'thread/name/set') {
    threadNames.set(request.params.threadId, request.params.name);
    write({ method: 'thread/name/updated', params: { threadId: request.params.threadId, threadName: request.params.name } });
  } else if (request.method === 'account/read') {
    result = { account: { type: 'chatgpt' } };
  } else if (request.method === 'thread/unsubscribe') {
    hiddenThreads.delete(request.params.threadId);
  } else if (request.method === 'thread/list') {
    const params = request.params || {};
    let threads = Array.from({ length: 90 }, (_, i) => ({
      id: `picker-thread-${i}`, name: `History ${String(i).padStart(3, '0')}`,
      preview: `Question ${i}`, cwd: i % 2 === 0 ? process.cwd() : '/other-project',
      createdAt: 1700000000 + i, updatedAt: 1700001000 - i,
      gitInfo: { branch: `feature/history-${i}` }
    }));
    for (const [id, name] of threadNames) {
      if (id === 'thread-e2e' || id.includes('untitled-history-e2e')) threads.unshift({ id, name, preview: 'Original question', cwd: process.cwd(), createdAt: 1700000000, updatedAt: 1800000000 });
    }
    if (params.cwd) threads = threads.filter(thread => thread.cwd === params.cwd);
    if (params.searchTerm) threads = threads.filter(thread => thread.name.toLowerCase().includes(params.searchTerm.toLowerCase()));
    threads.sort((a, b) => params.sortKey === 'created_at' ? b.createdAt - a.createdAt : b.updatedAt - a.updatedAt);
    const offset = Number(params.cursor || 0);
    const limit = Number(params.limit || 40);
    result = { data: threads.slice(offset, offset + limit), nextCursor: offset + limit < threads.length ? String(offset + limit) : null };
  } else if (request.method === 'thread/fork') {
    threadNames.set(`fork-of-${request.params?.threadId}`, savedThreadName(request.params?.threadId));
    result = { thread: { id: `fork-of-${request.params?.threadId}`, turns: [] }, initialTurnsPage: { data: [], nextCursor: null } };
    if (request.params?.threadId === 'plan-history-e2e') result = historicalPlanThread('fork-of-plan-history-e2e');
  } else if (request.method === 'thread/resume') {
    const threadId = request.params?.threadId || 'thread-e2e';
    if (threadId === 'stuck-resume-e2e') return;
    if (threadId === 'disconnected-resume-e2e') { outputLost = true; return; }
    if (threadId === 'plan-history-e2e') {
      result = historicalPlanThread(threadId);
    } else if (threadId === 'large-history-e2e') {
      if (request.params?.excludeTurns !== true || request.params?.initialTurnsPage?.itemsView !== 'full') {
        write({ id: request.id, error: { message: 'large history must use metadata-only paginated resume' } });
        return;
      }
      const turns = largeHistoryTurns();
      result = {
        thread: { id: threadId, turns: [] },
        initialTurnsPage: { data: turns.slice(0, 50), nextCursor: 'large-history-page-2' }
      };
    } else {
      result = { thread: { id: threadId, turns: [] }, initialTurnsPage: { data: [], nextCursor: null } };
    }
  } else if (request.method === 'thread/turns/list') {
    if (request.params?.threadId?.includes('untitled-history-e2e') && request.params?.itemsView === 'summary') {
      result = { data: [{ items: [
        { type: 'userMessage', content: [{ type: 'text', text: 'Diagnose the old project build failure' }] },
        { type: 'agentMessage', phase: 'commentary', text: 'IGNORE TITLE COMMENTARY' },
        { type: 'agentMessage', phase: 'final_answer', text: 'The project build was repaired.' }
      ] }], nextCursor: null };
    } else if (request.params?.threadId?.startsWith('picker-thread-')) {
      if (request.params?.itemsView !== 'summary' || request.params?.limit !== 3) {
        write({ id: request.id, error: { message: 'previews must use bounded summaries' } });
        return;
      }
      result = { data: [{ id: 'preview-turn', items: [
        { type: 'userMessage', content: [{ type: 'text', text: `Recent question for ${request.params.threadId}` }] },
        { type: 'agentMessage', text: 'Recent answer <script>not executable</script>' },
        { type: 'commandExecution', aggregatedOutput: 'Hidden tool payload' }
      ] }], nextCursor: 'older-preview-not-needed' };
    } else if (request.params?.threadId === 'large-history-e2e' && request.params?.cursor === 'large-history-page-2') {
      if (request.params?.itemsView !== 'full') {
        write({ id: request.id, error: { message: 'history pages must include full items' } });
        return;
      }
      result = { data: largeHistoryTurns().slice(50), nextCursor: null };
    } else {
      result = { data: [], nextCursor: null };
    }
  } else if (request.method === 'turn/interrupt') {
    if (inputQuestion?.turnId === request.params?.turnId) finishInputQuestion('', 'interrupted');
    if (taskPlan?.turnId === request.params?.turnId) finishTaskPlan('interrupted');
    result = {};
  } else if (request.method === 'turn/steer') {
    if (!inputQuestion?.async || request.params?.expectedTurnId !== inputQuestion.turnId
      || request.params?.threadId !== 'thread-e2e' || request.params?.model || request.params?.cwd) {
      write({ id: request.id, error: { message: 'invalid question steer' } });
      return;
    }
    const answer = (request.params.input || []).map(item => item.text || '').join('\n');
    if (answer.includes('reject-once') && !inputQuestion.rejected) {
      inputQuestion.rejected = true;
      write({ id: request.id, error: { message: 'forced answer failure' } });
      return;
    }
    const turnId = inputQuestion.turnId;
    write({ id: request.id, result: { turnId } });
    setImmediate(() => {
      write({ method: 'item/completed', params: { threadId: 'thread-e2e', turnId,
        item: { id: `answer-echo-${turnId}`, type: 'userMessage', content: request.params.input }
      } });
      finishInputQuestion(`Received answer: ${answer}`);
    });
    return;
  } else if (request.method === 'thread/start') {
    if (request.params?.ephemeral) {
      const params = request.params;
      if (params.threadSource !== 'system' || params.sandbox !== 'read-only' || params.config?.['features.shell_tool'] !== false || params.config?.['features.hooks'] !== false) {
        write({ id: request.id, error: { message: 'title thread must use CLI isolation' } });
        return;
      }
      const id = `hidden-title-${++titleSequence}`;
      hiddenThreads.add(id);
      // Deliberately notify before the response to exercise routing races.
      write({ method: 'thread/started', params: { thread: { id, ephemeral: true } } });
      result = { thread: { id, ephemeral: true }, sandbox: { type: 'readOnly' } };
    } else {
      result = { thread: { id: 'thread-e2e' } };
    }
  } else if (request.method === 'turn/start') {
    const text = (request.params?.input || [])
      .filter(item => item?.type === 'text').map(item => item.text || '').join('\n');
    if (hiddenThreads.has(request.params.threadId)) {
      if (!request.params.outputSchema || Buffer.byteLength(text) > 960 || request.params.effort !== 'low') {
        write({ id: request.id, error: { message: 'invalid structured title turn' } });
        return;
      }
      const threadId = request.params.threadId;
      const turnId = `title-turn-${titleSequence}`;
      write({ id: request.id, result: { turn: { id: turnId } } });
      write({ method: 'turn/started', params: { threadId, turn: { id: turnId } } });
      setTimeout(() => {
        if (!hiddenThreads.has(threadId)) return;
        const failed = text.includes('__GLAD_E2E_TITLE_FAIL__');
        write({ method: 'item/completed', params: { threadId, turnId, item: { type: 'agentMessage', id: 'hidden-title-item', text: failed ? 'invalid JSON' : '{"title":"修复项目构建"}' } } });
        write({ method: 'turn/completed', params: { threadId, turn: { id: turnId, status: 'completed' } } });
      }, text.includes('__GLAD_E2E_TITLE_SLOW__') ? 1500 : 150);
      return;
    }
    if (text.includes('__GLAD_E2E_FAIL_SEND__')) {
      setTimeout(() => write({ id: request.id, error: { message: 'forced send failure' } }), 25);
      return;
    }
    const turnNumber = ++turnSequence;
    const turnId = `turn-e2e-${process.pid}-${turnNumber}`;
    write({ id: request.id, result: { turn: { id: turnId } } });
    setImmediate(() => {
      write({ method: 'turn/started', params: { threadId: 'thread-e2e', turn: { id: turnId } } });
      if (text.includes('__GLAD_E2E_PLAN')) {
        write({ method: 'item/completed', params: { threadId: 'thread-e2e', turnId,
          item: { id: `plan-intro-${turnId}`, type: 'agentMessage', text: '我会先检查实现，再进行验证。' }
        } });
        const steps = ['分析现有实现', '修改代码 <script>unsafe()</script>', '运行测试', '整理结果'];
        if (text.includes('_LONG')) {
          steps.push(...Array.from({ length: 24 }, (_, index) => `额外验证步骤 ${index + 1}：${'检查长任务文本'.repeat(8)}`));
          write({ method: 'item/agentMessage/delta', params: {
            threadId: 'thread-e2e', turnId, itemId: `plan-progress-${turnId}`,
            delta: Array.from({ length: 35 }, (_, index) => `检查记录 ${index + 1}：正在核对事件处理、任务状态和界面布局。`).join('\n\n')
          } });
        }
        taskPlan = { turnId, steps, timers: [] };
        const update = done => write({ method: 'turn/plan/updated', params: {
          threadId: 'thread-e2e', turnId, explanation: '先定位问题，再修改并验证。',
          plan: steps.map((step, index) => ({ step, status: index < done ? 'completed' : index === done ? 'inProgress' : 'pending' }))
        } });
        update(1);
        taskPlan.timers.push(setTimeout(() => update(2), 1200));
        if (text.includes('_CHILD')) {
          write({ method: 'turn/started', params: { threadId: 'child-plan-thread', turn: { id: 'child-plan-turn' } } });
          write({ method: 'turn/plan/updated', params: { threadId: 'child-plan-thread', turnId: 'child-plan-turn', plan: [
            { step: '子任务独立检查', status: 'inProgress' }
          ] } });
        }
        if (!text.includes('_HOLD')) taskPlan.timers.push(setTimeout(() => finishTaskPlan(text.includes('_FAIL') ? 'failed' : 'completed'), 4000));
        return;
      }
      if (text.includes('__GLAD_E2E_ASYNC_QUESTION') || text.includes('__GLAD_E2E_SYNC_QUESTION__')) {
        const async = text.includes('__GLAD_E2E_ASYNC_QUESTION');
        inputQuestion = { async, turnId, rpcID: `question-${turnId}` };
        if (async) {
          write({ method: 'item/completed', params: { threadId: 'thread-e2e', turnId,
            item: { id: `question-${turnId}`, type: 'agentMessage', delivery: 'async', text: '1000条是独立动作还是录制？', questions: [
              { title: '1000条是独立动作还是录制？', options: ['1000次独立动作', '1000段录制'] },
              { title: '预计几位参与者？' }
            ] }
          } });
          inputQuestion.timer = setInterval(() => write({ method: 'item/agentMessage/delta', params: {
            threadId: 'thread-e2e', turnId, itemId: `progress-${turnId}`, delta: '继续整理。'
          } }), 250);
          if (text.includes('_IDLE__')) setTimeout(() => finishInputQuestion('Work completed before the answer'), 500);
        } else {
          write({ id: inputQuestion.rpcID, method: 'item/tool/requestUserInput', params: {
            threadId: 'thread-e2e', turnId, itemId: `question-${turnId}`, isBlocking: true,
            questions: [
              { id: 'count', header: '采集数量', question: '1000条是独立动作还是录制？', options: [
                { label: '1000次独立动作', description: '每次动作单独计数' },
                { label: '1000段录制', description: '每段可能包含多次动作' }
              ] },
              { id: 'people', header: '参与者', question: '预计几位参与者？' }
            ]
          } });
        }
        return;
      }
      // 保持主进程和管道存活，模拟 Codex 输出线程单独失效。
      if (text.includes('__GLAD_E2E_SILENT_TRANSPORT__') || text.includes('__GLAD_E2E_CLOSE_STDOUT__')) {
        write({ method: 'item/started', params: {
          threadId: 'thread-e2e', turnId,
          item: { id: `lost-command-${process.pid}-${turnNumber}`, type: 'commandExecution', command: 'simulated-disconnection', status: 'running' }
        } });
        setTimeout(() => {
          outputLost = true;
          if (text.includes('__GLAD_E2E_CLOSE_STDOUT__')) require('node:fs').closeSync(1);
        }, 1000);
        return;
      }
      if (text.includes('__GLAD_E2E_LONG_STDERR__')) {
        process.stderr.write('x'.repeat(256 * 1024) + '\n');
      }
      if (text.includes('__GLAD_E2E_APPROVAL__')) {
        const itemId = `approval-command-${process.pid}-${turnNumber}`;
        const approvalId = `approval-request-${process.pid}-${turnNumber}`;
        write({
          method: 'item/started',
          params: {
            threadId: 'thread-e2e', turnId,
            item: { id: itemId, type: 'commandExecution', command: 'approval-command', status: 'running' }
          }
        });
        approvalRequests.set(approvalId, { threadId: 'thread-e2e', turnId, itemId });
        write({
          id: approvalId,
          method: 'item/commandExecution/requestApproval',
          params: { threadId: 'thread-e2e', turnId, itemId, reason: 'Allow approval-command to run?' }
        });
        return;
      }
      if (text.includes('__GLAD_E2E_STUCK_ABORT__')) {
        write({
          method: 'item/started',
          params: {
            threadId: 'thread-e2e', turnId,
            item: { id: `stuck-command-${process.pid}-${turnNumber}`, type: 'commandExecution', command: 'stuck-command', status: 'running' }
          }
        });
        return;
      }
      if (text.includes('__GLAD_E2E_LARGE_OUTPUT__')) {
        const itemId = `large-command-${turnNumber}`;
        write({
          method: 'item/started',
          params: {
            threadId: 'thread-e2e', turnId,
            item: { id: itemId, type: 'commandExecution', command: 'large-output', status: 'running' }
          }
        });
        const chunk = 'x'.repeat(256 * 1024);
        for (let index = 0; index < 40; index += 1) {
          write({
            method: 'item/commandExecution/outputDelta',
            params: { threadId: 'thread-e2e', turnId, itemId, delta: chunk }
          });
        }
        write({
          method: 'item/completed',
          params: {
            threadId: 'thread-e2e', turnId,
            item: { id: itemId, type: 'commandExecution', command: 'large-output', status: 'completed', exitCode: 0 }
          }
        });
        write({
          method: 'turn/completed',
          params: { threadId: 'thread-e2e', turn: { id: turnId, status: 'completed' } }
        });
        return;
      }
      if (text.includes('__GLAD_E2E_SUBAGENT_LIFECYCLE__') || text.includes('__GLAD_E2E_NOTIFICATION_SCOPE__')) {
        const childThreadId = `child-thread-${turnNumber}`;
        const childTurnId = `child-turn-${turnNumber}`;
        write({ method: 'turn/started', params: { threadId: childThreadId, turn: { id: childTurnId, startedAt: 1 } } });
        write({
          method: 'item/started',
          params: {
            threadId: childThreadId, turnId: childTurnId,
            item: { id: `child-command-${turnNumber}`, type: 'commandExecution', command: 'child-command', status: 'running' }
          }
        });
        setTimeout(() => {
          write({
            method: 'item/completed',
            params: {
              threadId: childThreadId, turnId: childTurnId,
              item: { id: `child-command-${turnNumber}`, type: 'commandExecution', command: 'child-command', status: 'completed' }
            }
          });
          write({ method: 'thread/status/changed', params: { threadId: childThreadId, status: { type: 'idle' } } });
          write({
            method: 'turn/completed',
            params: { threadId: childThreadId, turn: { id: childTurnId, status: 'completed', startedAt: 1, completedAt: 2 } }
          });
          write({ method: 'thread/status/changed', params: { threadId: 'thread-e2e', status: { type: 'idle' } } });
        }, 500);
        setTimeout(() => {
          write({
            method: 'item/completed',
            params: {
              threadId: 'thread-e2e', turnId,
              item: { id: `agent-e2e-${turnNumber}`, type: 'agentMessage', text: 'root completed after child' }
            }
          });
          write({
            method: 'turn/completed',
            params: { threadId: 'thread-e2e', turn: { id: turnId, status: 'completed' } }
          });
        }, text.includes('__GLAD_E2E_NOTIFICATION_SCOPE__') ? 10000 : 1500);
        return;
      }
      write({
        method: 'item/completed',
        params: {
          threadId: 'thread-e2e', turnId,
          item: { id: `user-e2e-${turnNumber}`, type: 'userMessage', content: request.params?.input || [] }
        }
      });
      write({
        method: 'turn/completed',
        params: { threadId: 'thread-e2e', turn: { id: turnId, status: 'completed' } }
      });
    });
    return;
  } else if (request.method === 'config/read') {
    result = { config: {
      model: 'gpt-e2e', model_reasoning_effort: 'medium',
      sandbox_mode: 'read-only', approval_policy: 'untrusted'
    } };
  } else if (request.method === 'config/batchWrite') {
    const edits = Array.isArray(request.params?.edits) ? request.params.edits : [];
    const values = Object.fromEntries(edits.map(edit => [edit.keyPath, edit.value]));
    const expectedKeys = ['approval_policy', 'model', 'model_reasoning_effort', 'sandbox_mode'];
    const valid = edits.length === 4
      && edits.every(edit => edit.mergeStrategy === 'upsert')
      && Object.keys(values).sort().join(',') === expectedKeys.join(',')
      && Object.values(values).every(value => typeof value === 'string' && value.length > 0);
    if (!valid) {
      write({ id: request.id, error: { message: `invalid global defaults batch: ${JSON.stringify(values)}` } });
      return;
    }
    result = {};
  } else if (request.method === 'model/list') {
    result = {
      data: [{
        id: 'gpt-e2e',
        displayName: 'GPT E2E',
        isDefault: true,
        contextWindow: 128000,
        defaultReasoningEffort: 'medium',
        supportedReasoningEfforts: ['low', 'medium', 'high']
      }, { id: 'gpt-5.6-luna', model: 'gpt-5.6-luna', displayName: 'Luna', supportedReasoningEfforts: ['low'] }]
    };
  }

  write({ id: request.id, result });
});
